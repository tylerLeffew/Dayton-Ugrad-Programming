public class lab09a2 {
    public static void main(String[] args)
    {
        for(int num =0;num<=100;num++)
        {
            boolean even = (num ==0) ||( num %2 ==0);
            
            if(even) {
                System.out.println(num +": even");
            }else {
                System.out.println(num + ": odd");
            }
            
        }
    }
}
