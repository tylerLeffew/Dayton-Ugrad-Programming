public class lab09a {
    public static void main (String []args)
    {
        for(int num=1;num<100;num++)
        {
           boolean div5 =(num% 5==0);
           boolean end5 = (num %10==5);
           if(div5){
               System.out.print("Big ");
           }
          if(end5){
              System.out.println("Bird ");
          }
          if(!div5 &&!end5)
          {
              System.out.print(num);
          }
          //newline
          System.out.println();
        }
    }
}
